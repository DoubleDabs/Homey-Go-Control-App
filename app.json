        "xlarge": "/drivers/gd00z/assets/images/xlarge.png"
      },
      "zwave": {
        "manufacturerId": 335,
        "productTypeId": [
          18244
        ],
        "productId": [
          13616
        ],
        "requireSecure": true,
        "learnmode": {
          "image": "/drivers/gd00z/assets/learnmode.svg",
          "instruction": {
            "en": "Press and release the Learn button on the GD00Z. The blue LED flashes while it pairs."
          }
        },
        "unlearnmode": {
          "image": "/drivers/gd00z/assets/learnmode.svg",
          "instruction": {
            "en": "Press and release the Learn button on the GD00Z to remove it from its current network."
          }
        },
        "associationGroups": [
          1
        ]
      }
    }
  ],
